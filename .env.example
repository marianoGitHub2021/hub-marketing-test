APP_NAME="Hub Marketing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Proxy di cui fidarsi per X-Forwarded-* (es. "*" in Codespaces, IP del bilanciatore in produzione)
TRUSTED_PROXIES=

APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sviluppo locale: sqlite. Produzione: mariadb.
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hub_marketing
# DB_USERNAME=hub
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="webmarketing@network-service.it"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login con Google aziendale (client OAuth del dominio network-service.it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
HUB_LOGIN_DOMAIN=network-service.it

# Solo sviluppo locale: accesso senza Google con un'email del dominio. Mai attivo in produzione.
HUB_DEV_LOGIN=false

# Connettori MCP di Network Service (vedi docs/specifica-tecnica-mvp0.md)
MCP_GOOGLE_ADS_URL=
MCP_GOOGLE_ADS_TOKEN=
MCP_GA4_URL=
MCP_GA4_TOKEN=
MCP_FIDO_URL=
MCP_FIDO_TOKEN=
MCP_QUOTO_URL=
MCP_QUOTO_TOKEN=

# Meta Marketing API (token utente di sistema)
META_SYSTEM_USER_TOKEN=
